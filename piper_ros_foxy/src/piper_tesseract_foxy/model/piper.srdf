<?xml version="1.0"?>
<robot name="piper_planning">
  <group name="manipulator">
    <chain base_link="base_link" tip_link="camera_optical_frame"/>
  </group>
  <group_state name="neutral" group="manipulator">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0.8"/>
    <joint name="joint3" value="-0.7"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0.7"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <kinematics_plugin_config filename="package://piper_tesseract_foxy/model/piper_plugins.yaml"/>
  <contact_managers_plugin_config filename="package://piper_tesseract_foxy/model/contact_manager_plugins.yaml"/>
  <!-- Only mechanically adjacent/design-contact pairs are disabled. -->
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="gripper_base" reason="Fixed"/>
  <disable_collisions link1="gripper_base" link2="link7" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="link8" reason="Adjacent"/>
  <disable_collisions link1="link7" link2="link8" reason="Closed-gripper design contact"/>
  <disable_collisions link1="l515_camera_cable_envelope" link2="l515_mount_envelope" reason="Rigid attachment"/>
  <disable_collisions link1="l515_camera_cable_envelope" link2="link6" reason="Rigid attachment"/>
  <disable_collisions link1="l515_camera_cable_envelope" link2="gripper_base" reason="Rigid attachment"/>
  <disable_collisions link1="l515_camera_cable_envelope" link2="link7" reason="Rigid attachment"/>
  <disable_collisions link1="l515_camera_cable_envelope" link2="link8" reason="Rigid attachment"/>
  <disable_collisions link1="l515_mount_envelope" link2="link6" reason="Rigid attachment"/>
  <disable_collisions link1="l515_mount_envelope" link2="gripper_base" reason="Rigid attachment"/>
  <disable_collisions link1="l515_mount_envelope" link2="link7" reason="Rigid attachment"/>
  <disable_collisions link1="l515_mount_envelope" link2="link8" reason="Rigid attachment"/>
</robot>
