diff --git a/realsense2_camera/include/aligned_depth_guard.h b/realsense2_camera/include/aligned_depth_guard.h
new file mode 100644
index 0000000..671f8fb
--- /dev/null
+++ b/realsense2_camera/include/aligned_depth_guard.h
@@ -0,0 +1,29 @@
+// Reject SDK pass-through depth before assigning color-camera geometry.
+#pragma once
+#include <librealsense2/rs.hpp>
+#include <cmath>
+namespace realsense2_camera {
+inline bool alignedDepthMatchesColor(const rs2::frame& depth, const rs2::frame& color)
+{
+    if (!depth || !color) return false;
+    const auto dp = depth.get_profile().as<rs2::video_stream_profile>();
+    const auto cp = color.get_profile().as<rs2::video_stream_profile>();
+    if (!dp || !cp) return false;
+    const auto d = dp.get_intrinsics();
+    const auto c = cp.get_intrinsics();
+    if (d.width != c.width || d.height != c.height || d.model != c.model) return false;
+    const float dv[] = {d.fx, d.fy, d.ppx, d.ppy};
+    const float cv[] = {c.fx, c.fy, c.ppx, c.ppy};
+    for (int i=0; i<4; ++i)
+        if (!std::isfinite(dv[i]) || !std::isfinite(cv[i]) || std::abs(dv[i]-cv[i]) > 1e-6f) return false;
+    if (d.fx <= 0 || d.fy <= 0) return false;
+    for (int i=0; i<5; ++i)
+        if (!std::isfinite(d.coeffs[i]) || !std::isfinite(c.coeffs[i]) || std::abs(d.coeffs[i]-c.coeffs[i]) > 1e-6f) return false;
+    const auto extrinsics = dp.get_extrinsics_to(cp);
+    for (int i=0; i<9; ++i)
+        if (!std::isfinite(extrinsics.rotation[i]) || std::abs(extrinsics.rotation[i] - (i%4 == 0 ? 1.f : 0.f)) > 1e-6f) return false;
+    for (int i=0; i<3; ++i)
+        if (!std::isfinite(extrinsics.translation[i]) || std::abs(extrinsics.translation[i]) > 1e-6f) return false;
+    return true;
+}
+}
